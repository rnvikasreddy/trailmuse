# Copy to .env and fill in. Everything here is optional for local development.
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Local Postgres with PostGIS. docker-compose sets this for you.
DATABASE_URL=postgis://trailmuse:trailmuse@localhost:5432/trailmuse
# Free key from https://cloud.maptiler.com (100k map loads a month on the free plan).
MAPTILER_KEY=
# Launch region as west,south,east,north
REGION_BBOX=-123.1,36.95,-121.5,38.35
REGION_NAME=the Bay Area
SERVE_MEDIA=0
